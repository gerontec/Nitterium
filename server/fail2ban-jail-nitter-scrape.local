[nitter-scrape]
enabled  = true
filter   = nitter-scrape
logpath  = /var/log/apache2/nitter_access.log
backend  = polling
port     = http,https,9495
# reasonable limit: 30 tweet pages in 10 min per IP, then a ban
maxretry = 30
findtime = 10m
bantime  = 1h
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1d
# own networks may poll without limit
ignoreip = 127.0.0.1/8 ::1 <own-ipv4> <own-ipv6-prefix>/64 10.8.0.0/24 10.9.0.0/24 192.168.0.0/16
